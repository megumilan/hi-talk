{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "exactOptionalPropertyTypes": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": ["src"]
}
