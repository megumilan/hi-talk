        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.5.1",
        "prettier": "3.9.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "lint-staged": {
        "*": "prettier . --write",
        "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": "eslint --config eslint.config.ts --fix"
